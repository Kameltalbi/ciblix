{
  "name": "bilan-crm",
  "version": "1.0.0",
  "private": true,
  "description": "CRM Bilan Carbone & Formations — Tunisie",
  "workspaces": [
    "frontend",
    "backend",
    "extension"
  ],
  "scripts": {
    "build:frontend": "npm run build -w bilan-crm-frontend",
    "build:extension": "NODE_ENV=production npm run build -w ciblix-connect-ai-extension",
    "package:extension": "bash scripts/package-extension.sh",
    "dev": "docker compose up",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "db:migrate": "docker compose exec backend npx prisma migrate dev",
    "db:seed": "docker compose exec backend npx prisma db seed",
    "db:studio": "docker compose exec backend npx prisma studio",
    "deploy": "bash scripts/deploy-pm2.sh",
    "deploy:docker": "bash scripts/deploy.sh"
  }
}
