  createdAt        DateTime @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandProfile     BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, brandProfileId, channel])
  @@map("brand_recommendations")
}

model BrandAlert {
  id             String   @id @default(cuid())
  organizationId String
  brandProfileId String
  type           String   // SEO_DROP, NO_PUBLISH, NEGATIVE_REVIEW, etc.
  severity       String   @default("INFO") // INFO, WARNING, CRITICAL
  message        String   @db.Text
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, brandProfileId, read, createdAt])
  @@map("brand_alerts")
}

model BrandCmsConnection {
  id              String   @id @default(cuid())
