// ═══════════════════════════════════════════════════════════════
//  BRAND PULSE AI — Profil marque, scores, articles, CMS
// ═══════════════════════════════════════════════════════════════
model BrandProfile {
  id              String   @id @default(cuid())
  organizationId  String
  slug            String   @default("primary")
  isPrimary       Boolean  @default(true)
  brandName       String
  websiteUrl      String
  sector          String?
  competitorName  String?
  competitorUrl   String?
  brandKeywords   Json     @default("[]") // string[]
  editorialTone   String   @default("professionnel")
  articlesPerWeek Int      @default(2)
  onboardingDone  Boolean  @default(false)
  lastAuditAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scoreSnapshots  BrandScoreSnapshot[]
  articles        BrandArticle[]
  recommendations BrandRecommendation[]
  alerts          BrandAlert[]
  cmsConnections  BrandCmsConnection[]
  channelConnections BrandChannelConnection[]
  competitorSnapshots BrandCompetitorSnapshot[]

  @@unique([organizationId, slug])
  @@index([organizationId, isPrimary])
  @@map("brand_profiles")
}

model BrandScoreSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  brandProfileId String
  channel        String   // SEO, SOCIAL, REVIEWS, PRESS, LLM, WEBSITE, GLOBAL
  score          Int      // 0-100
  weight         Float    @default(0)
  details        Json?
  computedAt     DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, brandProfileId, channel, computedAt])
  @@map("brand_score_snapshots")
}

model BrandArticle {
  id               String    @id @default(cuid())
  organizationId   String
  brandProfileId   String
  status           String    @default("PROPOSED") // PROPOSED, DRAFTING, PENDING_REVIEW, APPROVED, REJECTED, SCHEDULED, PUBLISHED
  format           String    @default("SEO") // SEO, LONGFORM, FAQ, COMPARATIVE
  title            String?
  slug             String?
  metaTitle        String?
  metaDescription  String?   @db.Text
  contentMarkdown  String?   @db.Text
  targetKeywords   Json      @default("[]")
  topicReason      Json?
  estimatedImpact  Int?
  estimatedSeoScore Int?
  publishedUrl     String?
  publishedAt      DateTime?
  scheduledAt      DateTime?
  cmsPlatform      String?
  impactSeoDelta   Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandProfile     BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, brandProfileId, status])
  @@index([organizationId, brandProfileId, createdAt])
  @@map("brand_articles")
}

model BrandRecommendation {
  id               String   @id @default(cuid())
  organizationId   String
  brandProfileId   String
  channel          String
  action           String   @db.Text
  estimatedImpact  Int      @default(0)
  difficulty       String   @default("MEDIUM") // EASY, MEDIUM, HARD
  timeline         String   @default("SHORT") // SHORT, MEDIUM, LONG
