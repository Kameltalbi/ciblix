// ═══════════════════════════════════════════════════════════════
//  BACKUP LOG — Historique des sauvegardes
// ═══════════════════════════════════════════════════════════════
model BackupLog {
  id        String   @id @default(cuid())
  path      String
  size      BigInt
  status    String   // SUCCESS, FAILED
  error     String?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
