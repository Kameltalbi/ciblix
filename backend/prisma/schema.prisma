// ═══════════════════════════════════════════════════════════════
//  SCOUT AI — Profil de veille + opportunités détectées
// ═══════════════════════════════════════════════════════════════
model ScoutProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  keywords       Json     // string[] — mots-clés métier
  sectors        Json     // string[] — secteurs d'activité
  geoZones       Json     // string[] — zones géographiques
  tenderEnabled  Boolean  @default(true)
  eventEnabled   Boolean  @default(true)
  newsEnabled    Boolean  @default(true)
  autoScanEnabled Boolean @default(false)
  scanIntervalH  Int      @default(24) // intervalle en heures
  lastScanAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

