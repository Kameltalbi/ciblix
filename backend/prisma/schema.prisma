// Prisma schema pour ktOptima
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
//  ORGANIZATION — Tenant/Client pour le multitenant
// ═══════════════════════════════════════════════════════════════
model Organization {
  id          String   @id @default(cuid())
  name        String   // ex: "Bilan Tunisie"
  email       String?  // Email de contact de l'organisation
  phone       String?
  address     String?
  tva         String?  // Numéro TVA
  logoUrl     String?  // URL du logo
  paymentStatus String @default("PENDING") // PENDING, APPROVED, REJECTED
  suspended   Boolean  @default(false)
  plan        String   @default("FREE") // FREE, BUSINESS, ENTERPRISE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       User[]
  clients     Client[]
  leads       Lead[]
  affaires    Affaire[]
  products    Product[]
  activites   Activite[]
  leadActivites LeadActivite[]
  calendarEvents CalendarEvent[]
  expenses    Expense[]
  emails      Email[]
  gmailTokens GmailToken[]
  previsionnels PrevisionMois[]
  notifications Notification[]
  supportTickets SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  auditLogs   AuditLog[]
  customCategories CustomCategory[]
  emailTemplates EmailTemplate[]
  subscriptions Subscription[]
  salesObjectives SalesObjective[]
  userPermissions UserPermission[]
  commissionConfigs CommissionConfig[]
  aiProspects     AiProspect[]
  prospectingAutomation ProspectingAutomation?
  agents          OrganizationAgent[]
  scoutProfile    ScoutProfile?
  scoutOpportunities ScoutOpportunity[]
  agentUsageMonthly AgentUsageMonthly[]
  brandProfiles   BrandProfile[]
  brandScoreSnapshots BrandScoreSnapshot[]
  brandArticles   BrandArticle[]
  brandRecommendations BrandRecommendation[]
  brandAlerts       BrandAlert[]
  brandCmsConnections BrandCmsConnection[]
  brandChannelConnections BrandChannelConnection[]
  brandCompetitorSnapshots BrandCompetitorSnapshot[]
  brandApiKeys    BrandApiKey[]

  @@map("organizations")
}

// ═══════════════════════════════════════════════════════════════
//  USER — Utilisateur du CRM
// ═══════════════════════════════════════════════════════════════
model User {
  id           String   @id @default(cuid())
  organizationId String
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  /// Identifiant OpenID Connect Google (« sub ») — connexion SSO
  googleSub    String?  @unique
  role         UserRole @default(OWNER)
  failedLoginAttempts Int @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientsCreated   Client[]
  leadsCreated     Lead[]
  affairesCreated  Affaire[]
  assignedAffaires Affaire[] @relation("CommercialAffaires")
  calendarEventsCreated CalendarEvent[]
  expensesCreated  Expense[]
  gmailTokens      GmailToken?
  notifications    Notification[]
  createdSupportTickets SupportTicket[] @relation("SupportTicketCreatedBy")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignedTo")
  supportTicketMessages SupportTicketMessage[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  salesObjectives  SalesObjective[]
  permissions      UserPermission[]

  @@index([organizationId])
  @@map("users")
}

enum UserRole {
  OWNER       // Accès complet, gestion des utilisateurs
  PARTNER     // Accès limité, lecture seule sur les données
  COMMERCIAL  // Accès limité aux opportunités assignées, objectifs
  SUPERADMIN  // Super admin pour valider les paiements
}

// ═══════════════════════════════════════════════════════════════
//  CLIENT — Entreprises clientes
// ═══════════════════════════════════════════════════════════════
model Client {
  id          String   @id @default(cuid())
  organizationId String
  name        String   // ex: "UBCI"
  contactName String?  // ex: "Ahmed Ben Ali"
  email       String?
  phone       String?
  address     String?
  matricule   String?  // Matricule fiscal tunisien
  qualificatif String?  // ex: "PROSPECT" ou "CLIENT"
  notes       String?  @db.Text
  deletedAt   DateTime? // Soft delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  affaires    Affaire[]
  leads       Lead[]    @relation("ClientLeads")
  convertedFromLeads Lead[] @relation("LeadConversions")

  @@index([organizationId])
  @@index([name])
  @@index([deletedAt])
  @@map("clients")
}

// ═══════════════════════════════════════════════════════════════
//  LEAD — Prospects avant conversion en client/affaire
// ═══════════════════════════════════════════════════════════════
model Lead {
  id            String   @id @default(cuid())
  organizationId String
  clientId      String?
  client        Client?    @relation("ClientLeads", fields: [clientId], references: [id])
  name          String   // Nom de l'entreprise ou du prospect
  contactName   String?  // Nom du contact
  email         String?
  phone         String?
  company       String?  // Entreprise (si différent du nom principal)
  source        LeadSource @default(AUTRE) // Origine du lead
  status        LeadStatus @default(NEW) // État du lead
  score         Int      @default(0) // Score de qualification (0-100)
  estimatedValue Decimal? @db.Decimal(12, 3) // Valeur estimée DT
  notes         String?  @db.Text
  convertedToClientId String?
  convertedToClient Client?  @relation("LeadConversions", fields: [convertedToClientId], references: [id])
  deletedAt     DateTime? // Soft delete
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activites     LeadActivite[]
  calendarEvents CalendarEvent[]
  expenses      Expense[]
  aiProspectOrigin AiProspect?

  @@index([organizationId])
  @@index([status])
  @@index([score])
  @@index([deletedAt])
  @@map("leads")
}

enum LeadSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  EMAIL
  PHONE
  EVENT
  PARTNER
  AI_PROSPECTION
  AUTRE
}

enum LeadStatus {
  NEW        // Nouveau prospect
  CONTACTED  // Premier contact établi
  QUALIFIED  // Qualifié, prêt pour conversion
  CONVERTED  // Converti en client
  LOST       // Perdu
}

// ═══════════════════════════════════════════════════════════════
//  AI PROSPECT — Résultats prospection IA (recherche + qualification)
// ═══════════════════════════════════════════════════════════════
enum AiProspectStatus {
  FOUND
  QUALIFIED
  CONTACTED
  IN_PIPELINE
  IGNORED
}

model AiProspect {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyName      String
  website          String?
  linkedin         String?
  phone            String?
  email            String?
  city             String?
  country          String?
  industry         String?
  companySize      String?

  score            Int               @default(0)
  scoreReason      String?           @db.Text
  suggestedPitch   String?           @db.Text
  aiTags           Json?
  potentialLevel   String?
  commercialAngle  String?           @db.Text
  aiSummary        String?           @db.Text
  interestProbability Int?           // 0–100

  /// Enrichissement crawl site (si website présent)
  websiteTitle          String?
  websiteDescription    String?      @db.Text
  detectedEmails        Json?        // string[]
  facebookUrl           String?
  instagramUrl          String?
  faviconUrl              String?
  hasResponsiveWebsite    Boolean?
  hasSsl                  Boolean?
  seoScore                Int?       // 0–100 heuristique
  digitalPresenceLevel    String?    // FORT | MOYEN | FAIBLE
  technologiesDetected    Json?      // string[] (signaux simples : WordPress, GA, etc.)
  probableBusinessProblem String?    @db.Text
  suggestedOffer          String?    @db.Text

  leadId           String?           @unique
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)

  status           AiProspectStatus  @default(FOUND)
  lastSearchQuery  String?          @db.Text
  followUpPlan     Json?

  emailOpenedAt    DateTime?
  linkClickedAt    DateTime?
  lastReplyAt      DateTime?
  lastContactAt    DateTime?
  rawProvider      String?

  activities       AiProspectActivity[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([organizationId])
  @@index([status])
  @@map("ai_prospects")
}

/// Cache résultats recherche (évite appels Google répétés) — TTL côté métier (ex. 7 j.)
model ProspectingSearchCache {
  cacheKey      String   @id
  providerUsed  String
  payload       Json
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  @@index([expiresAt])
  @@map("prospecting_search_cache")
}

/// Cache enrichissement par URL normalisée
model ProspectingWebsiteCache {
  urlKey     String   @id
  payload    Json
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@map("prospecting_website_cache")
}

/// Prospection automatique périodique (1 ligne / organisation pour le MVP).
model ProspectingAutomation {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId     String?

  active              Boolean      @default(false)
  name                String       @default("Prospection planifiée")

  criteria            Json
  intervalHours       Int
  refreshCache        Boolean      @default(false)
  qualifyAfterSearch  Boolean      @default(true)
  maxNewPerRun        Int          @default(40)

  nextRunAt           DateTime
  lastRunAt           DateTime?
  lastRunImported     Int?
  lastRunQualified    Int?
  lastRunError        String?      @db.Text

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("prospecting_automations")
}

/// Timeline / tracking commercial (extensions futures : webhooks, pixel)
model AiProspectActivity {
  id             String     @id @default(cuid())
  organizationId String
  aiProspectId   String
  aiProspect     AiProspect @relation(fields: [aiProspectId], references: [id], onDelete: Cascade)
  type           String     // NOTE | EMAIL_OPENED | LINK_CLICKED | REPLY | CONTACT | SYSTEM
  title          String?
  metadata       Json?
  createdAt      DateTime   @default(now())

  @@index([aiProspectId, createdAt])
  @@index([organizationId])
  @@map("ai_prospect_activities")
}

// ═══════════════════════════════════════════════════════════════
//  CALENDAR EVENT — Événements du calendrier
// ═══════════════════════════════════════════════════════════════
model CalendarEvent {
  id            String   @id @default(cuid())
  organizationId String
  title         String
  description   String?  @db.Text
  startDate     DateTime
  endDate       DateTime
  allDay        Boolean  @default(false)
  eventType     EventType @default(MEETING)
  location      String?
  relatedAffaireId String?
  relatedAffaire Affaire? @relation(fields: [relatedAffaireId], references: [id], onDelete: SetNull)
  relatedLeadId String?
  relatedLead   Lead?    @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  status        EventStatus @default(SCHEDULED)
  reminderMinutes Int?   // Minutes avant l'événement pour le rappel
  deletedAt     DateTime? // Soft delete
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([startDate])
  @@index([eventType])
  @@index([deletedAt])
  @@map("calendar_events")
}

enum EventType {
  MEETING
  CALL
  TASK
  REMINDER
  DEADLINE
  AUTRE
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  POSTPONED
}

// ═══════════════════════════════════════════════════════════════
//  EXPENSE — Dépense
// ═══════════════════════════════════════════════════════════════
model Expense {
  id            String   @id @default(cuid())
  organizationId String
  title         String
  description   String?  @db.Text
  amount        Decimal  @db.Decimal(12, 3) // DT
  currency      String   @default("TND")
  category      String   @default("Autre")
  date          DateTime @default(now())
  relatedAffaireId String?
  relatedAffaire Affaire? @relation(fields: [relatedAffaireId], references: [id], onDelete: SetNull)
  relatedLeadId String?
  relatedLead   Lead?    @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  status        ExpenseStatus @default(PENDING)
  receiptUrl    String?  // URL du justificatif
  isRecurrent   Boolean  @default(false)
  recurrenceMonths String?  // e.g., "1,2,3" for months to repeat
  notes         String?  @db.Text
  deletedAt     DateTime? // Soft delete
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([date])
  @@index([category])
  @@index([status])
  @@index([deletedAt])
  @@map("expenses")
}

enum ExpenseCategory {
  OPERATIONAL // Frais opérationnels
  TRAVEL // Déplacements
  MEAL // Repas
  ACCOMMODATION // Hébergement
  EQUIPMENT // Matériel
  SOFTWARE // Logiciels
  MARKETING // Marketing
  COMMISSION // Commissions
  OTHER // Autre
}

// ═══════════════════════════════════════════════════════════════
//  CUSTOM CATEGORY — Catégories personnalisées (dépenses/revenus)
// ═══════════════════════════════════════════════════════════════
model CustomCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           CategoryType
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name, type])
  @@index([organizationId, type])
  @@map("custom_categories")
}

enum CategoryType {
  EXPENSE
  REVENUE
}

enum ExpenseStatus {
  PENDING // En attente
  APPROVED // Approuvé
  REJECTED // Rejeté
  PAID // Payé
}

// ═══════════════════════════════════════════════════════════════
//  AFFAIRE — Deal / Opportunité (cœur du CRM)
// ═══════════════════════════════════════════════════════════════
model Affaire {
  id            String        @id @default(cuid())
  organizationId String
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Détails prestation
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  type          String        @default("Autre")
  title         String?       // ex: "Bilan Carbone UBCI 2026" - auto-généré si non fourni
  description   String?       @db.Text
  montantHT     Decimal       @db.Decimal(12, 3) // DT, 3 décimales

  // Pipeline
  statut        StatutAffaire @default(PROSPECT)
  probabilite   Int           @default(50) // 0-100 %
  score         Int           @default(0) // Lead score 0-100

  // Planning
  moisPrevu     Int           // 1-12
  anneePrevue   Int           // 2026, 2027, 2028
  dateClotureReelle DateTime?
  prochaineAction String?      // ex: "Appeler client", "Envoyer devis"
  dateProchaineAction DateTime?

  // Partenaire & commission
  viaPartenaire Boolean       @default(false)
  tauxCommission Decimal      @db.Decimal(5, 2) @default(40.00) // 40%

  // Commercial assigné
  assignedToId String?
  assignedTo    User?         @relation("CommercialAffaires", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Liens vers Softfacture (quand devis/facture créés)
  devisId       String?       // ID retourné par Softfacture API
  devisNumero   String?
  devisPdfUrl   String?
  factureId     String?
  factureNumero String?
  facturePdfUrl String?

  // Méta
  notes         String?       @db.Text
  deletedAt     DateTime?     // Soft delete
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])

  // Relations
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activites     Activite[]
  calendarEvents CalendarEvent[]
  expenses      Expense[]
  emails        Email[]

  @@index([organizationId])
  @@index([statut, anneePrevue])
  @@index([clientId])
  @@index([productId])
  @@index([assignedToId])
  @@index([deletedAt])
  @@map("affaires")
}

// AffaireType is now a free-form String managed via custom categories

enum StatutAffaire {
  PROSPECT     // 🟡 Premier contact
  QUALIFIE     // 🔵 Intérêt confirmé
  PROPOSITION  // � Offre envoyée
  NEGOCIATION  // 🟣 En discussion
  GAGNE        // ✅ Signé
  PERDU        // ❌ Refusé ou abandonné
}

// ═══════════════════════════════════════════════════════════════
//  ACTIVITE — Historique des actions sur une affaire
// ═══════════════════════════════════════════════════════════════
model Activite {
  id        String        @id @default(cuid())
  organizationId String
  affaireId String
  affaire   Affaire       @relation(fields: [affaireId], references: [id], onDelete: Cascade)
  type      ActiviteType
  title     String
  content   String?       @db.Text
  createdAt DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([affaireId, createdAt])
  @@map("activites")
}

// ═══════════════════════════════════════════════════════════════
//  LEAD ACTIVITE — Historique des actions sur un lead
// ═══════════════════════════════════════════════════════════════
model LeadActivite {
  id        String        @id @default(cuid())
  organizationId String
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActiviteType
  title     String
  content   String?       @db.Text
  createdAt DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId, createdAt])
  @@map("lead_activites")
}

enum ActiviteType {
  NOTE
  APPEL
  EMAIL_ENVOYE
  EMAIL_RECU
  RDV
  CHANGEMENT_STATUT
  DEVIS_CREE
  FACTURE_CREEE
  AUTRE
}

// ═══════════════════════════════════════════════════════════════
//  EMAIL — Emails envoyés depuis le CRM via Gmail
// ═══════════════════════════════════════════════════════════════
model Email {
  id          String   @id @default(cuid())
  organizationId String
  affaireId   String?
  affaire     Affaire? @relation(fields: [affaireId], references: [id], onDelete: SetNull)
  messageId   String?  // ID Gmail
  fromEmail   String
  toEmail     String
  subject     String
  body        String   @db.Text
  sent        Boolean  @default(false)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([affaireId])
  @@map("emails")
}

// ═══════════════════════════════════════════════════════════════
//  GMAIL TOKEN — OAuth tokens pour envoi d'emails
// SECURITY: Tokens stored in plain text. In production, consider encryption-at-rest (AES-256)
// ═══════════════════════════════════════════════════════════════
model GmailToken {
  id           String   @id @default(cuid())
  organizationId String
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String   @db.Text // Encrypted at rest
  refreshToken String   @db.Text // Encrypted at rest
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("gmail_tokens")
}

// ═══════════════════════════════════════════════════════════════
//  PREVISIONNEL — Hypothèses mensuelles paramétrables
// ═══════════════════════════════════════════════════════════════
model PrevisionMois {
  id               String  @id @default(cuid())
  organizationId    String
  annee            Int
  mois             Int     // 1-12
  nbBilansPrevu    Int     @default(0)
  prixMoyenBilan   Decimal @db.Decimal(12, 3) @default(0)
  joursFormation   Int     @default(0)
  tarifJourFormation Decimal @db.Decimal(12, 3) @default(0)
  estEte           Boolean @default(false)
  tauxPartenaire   Decimal @db.Decimal(5, 2) @default(0) // % d'affaires via partenaire
  notes            String?
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@unique([organizationId, annee, mois])
  @@map("prevision_mois")
}

// ═══════════════════════════════════════════════════════════════
//  PRODUCT — Produits/Services proposés
// ═══════════════════════════════════════════════════════════════
model Product {
  id          String   @id @default(cuid())
  organizationId String
  name        String   // ex: "Bilan Carbone Standard"
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 3) // Prix unitaire DT
  type        ProductType @default(SERVICE)
  categoryId  String?
  active      Boolean  @default(true)
  deletedAt   DateTime? // Soft delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     CustomCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  affaires    Affaire[]

  @@index([organizationId])
  @@index([active])
  @@index([deletedAt])
  @@index([categoryId])
  @@map("products")
}

// ═══════════════════════════════════════════════════════════════
//  NOTIFICATION — Notifications pour les utilisateurs
// ═══════════════════════════════════════════════════════════════
model Notification {
  id            String   @id @default(cuid())
  organizationId String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  content       String?  @db.Text
  link          String?  // URL to navigate to when clicked
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId, read])
  @@map("notifications")
}

enum NotificationType {
  AFFAIRE_SANS_ACTIVITE  // Affaire sans activité depuis X jours
  TASK_OVERDUE           // Tâche en retard
  AFFAIRE_PERDUE         // Affaire perdue
  AFFAIRE_GAGNEE         // Affaire gagnée
  DEVIS_CREE             // Devis créé
  FACTURE_CREEE          // Facture créée
  RAPPEL                 // Rappel personnalisé
  SUPPORT_TICKET_NEW     // Nouveau ticket support
  SUPPORT_TICKET_REPLY   // Réponse sur ticket support
  BRAND_PULSE_ALERT      // Alerte BrandPulse AI
}

model SupportTicket {
  id            String   @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User     @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assigneeId    String?
  assignee      User?    @relation("SupportTicketAssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)
  subject       String
  description   String   @db.Text
  status        SupportTicketStatus @default(OPEN)
  priority      SupportTicketPriority @default(MEDIUM)
  category      SupportTicketCategory @default(OTHER)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  closedAt      DateTime?
  messages      SupportTicketMessage[]

  @@index([organizationId, status])
  @@index([createdById, createdAt])
  @@index([assigneeId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id            String   @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String   @db.Text
  createdAt     DateTime @default(now())

  @@index([organizationId, ticketId, createdAt])
  @@index([authorId])
  @@map("support_ticket_messages")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  BUG
  BILLING
  FEATURE
  OTHER
}

// ═══════════════════════════════════════════════════════════════
//  REFRESH TOKEN — JWT refresh tokens pour authentification persistante
// SECURITY: Token stored in plain text. In production, hash with bcrypt for verification
// ═══════════════════════════════════════════════════════════════
model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique // Hashed with bcrypt
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

enum ProductType {
  SERVICE  // Bilan carbone, formation, conseil
  PRODUCT  // Produit physique
}

// ═══════════════════════════════════════════════════════════════
//  AUDIT LOG — Logs d'audit pour traçabilité des actions
// ═══════════════════════════════════════════════════════════════
model AuditLog {
  id            String   @id @default(cuid())
  organizationId String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        AuditAction
  entityType    String   // ex: "Client", "Affaire", "User"
  entityId      String   // ID de l'entité concernée
  oldValues     String?  @db.Text // Valeurs avant modification (JSON)
  newValues     String?  @db.Text // Valeurs après modification (JSON)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

// ═══════════════════════════════════════════════════════════════
//  EMAIL TEMPLATE — Templates d'emails personnalisables
// ═══════════════════════════════════════════════════════════════
model EmailTemplate {
  id            String   @id @default(cuid())
