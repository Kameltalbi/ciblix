  label           String?
  encryptedConfig String   @db.Text
  blogId          String?
  defaultStatus   String   @default("draft") // draft | publish
  active          Boolean  @default(true)
  lastTestedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, brandProfileId])
