# ─── Backend ───────────────────────────────────────
DATABASE_URL="postgresql://bilan:bilan_pass@postgres:5432/bilan_crm?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
# Origines CORS supplémentaires (virgules). www/apex du FRONTEND_URL sont déjà inclus.
# CORS_ORIGINS="https://staging.ciblix.com"

# ─── Softfacture API ───────────────────────────────
SOFTFACTURE_API_URL="https://api.softfacture.com"
SOFTFACTURE_API_KEY=""

# ─── Prospection IA (Prospecteur) ─────────────────
# ACTIF MAINTENANT :
# GOOGLE_PLACES_API_KEY=""
# ou : GOOGLE_MAPS_API_KEY=""  ou  PLACES_API_KEY=""
# OPENAI_API_KEY=""
# PROSPECTING_SEARCH_PROVIDER=google_places
# Place Details après Text Search (défaut: actif) :
# PROSPECTING_PLACES_DETAILS=1
# OpenAI scoring (actif dès OPENAI_API_KEY ; désactiver : PROSPECTING_OPENAI_SCORING=false)
#
# PLUS TARD — Bing Web Search :
# BING_SEARCH_API_KEY=""
# BING_SEARCH_ENDPOINT="https://api.bing.microsoft.com/v7.0/search"
# PROSPECTING_SEARCH_PROVIDER=bing_search
#
# PLUS TARD — Google Custom Search :
# GOOGLE_CSE_API_KEY=""
# GOOGLE_CSE_CX=""
# PROSPECTING_SEARCH_PROVIDER=google_cse
#
# PLUS TARD — scrape sites trouvés (Firecrawl) ; sans clé = crawl HTML natif déjà actif :
# FIRECRAWL_API_KEY=""
# Hunter.io (emails) :
# HUNTER_API_KEY=""
#
# Cache recherche + enrichissement site (ms, défaut 7 jours) :
# PROSPECTING_CACHE_TTL_MS=604800000
# Timeout crawl site (ms) :
# PROSPECTING_FETCH_TIMEOUT_MS=10000
# Désactiver la prospection automatique périodique :
# PROSPECTING_AUTOMATION_DISABLED=1

# ─── Gmail (OAuth2) ────────────────────────────────
# Crée un projet sur https://console.cloud.google.com
# Active Gmail API, crée credentials OAuth2
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/gmail/callback"
# Déconnexion SSO (OpenID). Par défaut = FRONTEND_URL + "/api/auth/google/callback".
# Si le frontend et l’API ne sont pas sur le même origin (dev sur ports différents) :
# GOOGLE_LOGIN_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
GOOGLE_LOGIN_REDIRECT_URI=""

# ─── PostgreSQL (docker-compose) ───────────────────
POSTGRES_USER="bilan"
POSTGRES_PASSWORD="bilan_pass"
POSTGRES_DB="bilan_crm"

# ─── Frontend ──────────────────────────────────────
VITE_API_URL="http://localhost:4000/api"
# Boutons « Continuer avec Google » (login / inscription). Désactivé par défaut.
# À activer après config Google OAuth : voir docs/GMAIL.md section SSO.
# VITE_ENABLE_GOOGLE_AUTH=true

# ─── Production (remplacer en prod) ─────────────────
# Domaine canonique SANS www (redirection Nginx www → apex) :
# FRONTEND_URL="https://ciblix.com"
# CORS_ORIGINS=""  # optionnel ; www est auto-ajouté depuis FRONTEND_URL
# DOMAIN="ciblix.com"
